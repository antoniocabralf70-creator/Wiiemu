name: Build Android APK

on:
  push:
    branches: ["**"]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Baixar o repositório
        uses: actions/checkout@v4

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar componentes Android
        run: |
          yes | sdkmanager --licenses >/dev/null
          sdkmanager --install \\
            "platforms;android-34" \\
            "build-tools;34.0.0" \\
            "ndk;26.1.10909125" \\
            "cmake;3.22.1"

      - name: Configurar Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"

      - name: Compilar APK debug
        shell: bash
        run: |
          set -o pipefail
          gradle --no-daemon --stacktrace assembleDebug 2>&1 | tee build.log

      - name: Publicar log da compilação
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: WiixEmu-build-log
          path: build.log
          if-no-files-found: ignore

      - name: Publicar APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: WiixEmu-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
